{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build server",
            "type": "shell",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "-Wall",
                "-I${workspaceFolder}/libs",
                "-I${workspaceFolder}/server_project",
                "${workspaceFolder}/server_project/server.cpp",
                "${workspaceFolder}/server_project/pars_http.cpp",
                "-o",
                "${workspaceFolder}/server_project/server_gdb"
            ],
            "options": {
                "cwd": "${workspaceFolder}/server_project"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Сборка сервера (server.cpp + pars_http.cpp)"
        },
        {
            "label": "build client",
            "type": "shell",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "-Wall",
                "-I${workspaceFolder}/libs",
                "${workspaceFolder}/client_project/client.cpp",
                "-o",
                "${workspaceFolder}/client_project/client_gdb"
            ],
            "options": {
                "cwd": "${workspaceFolder}/client_project"
            },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Сборка клиента"
        }
    ]
}